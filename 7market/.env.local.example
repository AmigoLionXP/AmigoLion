# Copie para .env.local e preencha com as credenciais do projeto Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca expor no client (sem prefixo NEXT_PUBLIC_). Usada só em route handlers
# server-only (webhook de pagamento, cron de comissões, jobs administrativos).
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o gateway de pagamento para validar a assinatura
# HMAC do webhook em /api/webhooks/pagamento (ver comentário no arquivo —
# gateway definitivo ainda pendente, brief Seção 10).
PAGAMENTO_WEBHOOK_SECRET=

# Usado pelo Vercel Cron para autenticar a chamada em
# /api/cron/comissoes-mensal (header "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=
