# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Direct connection (port 5432) — required for db:migrate and db:seed: they run DDL
# (CREATE POLICY, CREATE TRIGGER) and insert into auth.users, which need a privileged,
# non-pooled connection. Find it in Supabase → Project Settings → Database → Connection string
# → "URI" (not the pgbouncer one).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Pooled connection (port 6543, pgbouncer in transaction mode) — what the deployed app itself
# should use at runtime for lower connection overhead. If unset, app code falls back to
# DATABASE_URL above; set this in production once you're past local dev.
# DATABASE_URL_POOLED="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key — safe to expose to the browser]"
# Server-only. Never prefix with NEXT_PUBLIC_, never ship to the client. Used only by db/seed.ts
# (Auth Admin API) to create demo users — route handlers never touch this key, they go through
# the user's own session + RLS instead.
SUPABASE_SERVICE_ROLE_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe — planos 7M0 (R$497) a 7M7 (R$7.000) + cobrança de comissão sobre deals
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# After creating the 8 Prices in the Stripe dashboard (or via `stripe products create`), write
# each price_id into the `plans.stripe_price_id` column — /api/checkout reads it from there,
# not from env vars, so plans can be repriced without a deploy.

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (optional — falls back to a console-log stub when unset)
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------------
# Transactional email via Resend (optional — falls back to a console-log stub when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="7M Advisory <noreply@7madvisory.com>"

# ---------------------------------------------------------------------------
# 7M AI — Guia 7M AI chat (optional — falls back to the scripted/deterministic responder
# ported from the design prototype when unset, so the chat button never silently breaks)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
