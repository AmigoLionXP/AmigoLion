DATABASE_URL="postgresql://sevenmarket:sevenmarket@localhost:5432/sevenmarket?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# AgentProvider (7M AI) — provider-agnostic. "mock" works offline for local dev.
AGENT_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Commission engine
COMMISSION_MAX_OVERRIDE_PCT=28

# 7MARKET Business Scan™ — local disk storage for uploaded documents.
# Swap for an S3/GCS-backed path in production; the API shape doesn't change.
UPLOADS_DIR="./uploads"
